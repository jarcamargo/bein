    <episode-num system="original-air-date">20161208000000 +0000</episode-num>
    <desc>La aventura comienza cuando se abandona a diez participantes en la naturaleza remota de la Patagonia para que vivan lo más que puedan.</desc>
    <icon src="https://images.pluto.tv/series/5e2f8f44f1654539d0f553fa/tile.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
    <date>20161208</date>
