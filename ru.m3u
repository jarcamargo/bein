    <sub-title>Temporada 20, Episodio 1</sub-title>
    <category>Series</category>
    <category>Documentary</category>
  </programme>
  <programme channel="60d356a534f63f000850cdd7" start="20260804135455 +0000" stop="20260804144455 +0000">
    <title>Top Gear: Temporada 20, Episodio 2</title>
    <episode-num system="onscreen">S20E02</episode-num>
    <episode-num system="pluto">6536488ebdf3cf00088a18e7</episode-num>
    <episode-num system="original-air-date">20130101000000 +0000</episode-num>
    <desc>Jeremy Clarkson prueba el sensacional Ferrari F12 de 730 caballos en los amplios espacios de Escocia. Richard Hammond le saca partido a la potencia del deporte automovilístico para encontrar el mejor taxi del mundo.</desc>
    <icon src="https://images.pluto.tv/series/63048ee5946347001bf27bc1/tile_1774006560964.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
