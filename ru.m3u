    <sub-title>Pippi va de excursión</sub-title>
    <category>Series</category>
    <category>Children</category>
  </programme>
  <programme channel="6a0c25fe09705ebdf7e4599a" start="20260804114449 +0000" stop="20260804121742 +0000">
