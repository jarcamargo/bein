  <channel id="USBD3500025GS">
    <display-name>Stingray DJAZZ</display-name>
    <icon src="https://tvpnlogopus.samsungcloud.tv/platform/image/sourcelogo/vc/00/02/34/USBD3500025GS_20240826T191202SQUARE.png"/>
