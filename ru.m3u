    <series-id system="pluto">617b08b53eb0f4001a17727b</series-id>
    <category>Comedy</category>
    <category>Movie</category>
  </programme>
  <programme channel="5defde6d6c07b50009cf0757" start="20260804030700 +0000" stop="20260804044000 +0000">
    <title>Archivo 253</title>
    <episode-num system="original-air-date">20150101000000 +0000</episode-num>
    <desc>En Marzo del 2012, cuatro amigos entraron a grabar a un hospital psiquiátrico abandonado de la Ciudad de México. Esto fue lo que encontraron.</desc>
    <icon src="https://images.pluto.tv/episodes/6107ef7f94cf330013d2b4ab/poster_1769216042110.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=1000&amp;q=75&amp;w=694"/>
