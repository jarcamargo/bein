    <sub-title>Episodio 2</sub-title>
    <category>Comedy</category>
    <category>Series</category>
    <category>Variety</category>
  </programme>
  <programme channel="699763d184235f26d5056002" start="20260804055153 +0000" stop="20260804061753 +0000">
    <title>Enchufe.TV</title>
    <episode-num system="onscreen">S18E03</episode-num>
    <episode-num system="pluto">6732113fe482950008cb1d4b</episode-num>
    <episode-num system="original-air-date">20120101000000 +0000</episode-num>
    <desc>¿Quieres saber qué tipo de borracho eres? Rápido, mira este episodio y se te revelará el resultado al fondo de tu copa. Y si no te identificas es porque con nosotros no has tomado.</desc>
    <icon src="https://images.pluto.tv/series/609440ae41fc480013268805/tile_1782275423342.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
