    <category>Children</category>
  </programme>
  <programme channel="5fcea93ffcf94500071c4b2f" start="20260804002900 +0000" stop="20260804005900 +0000">
    <title>Kenan y Kel</title>
    <episode-num system="onscreen">S01E15</episode-num>
    <episode-num system="pluto">5f5a9fc43dca0000148563c4</episode-num>
    <episode-num system="original-air-date">19960101000000 +0000</episode-num>
    <desc>Kenan ha ahorrado suficiente dinero para comprar una nueva bicicleta justo a tiempo para Navidad, pero ¿gastará ese dinero solo para él? ¿O habrá un espacio en su corazón para el espíritu navideño?</desc>
    <icon src="https://images.pluto.tv/series/5eff42e91bfe8e001a9a5460/tile_1768770360980.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
