    <category>Comedy</category>
    <category>Series</category>
    <category>Children</category>
  </programme>
  <programme channel="5fcea93ffcf94500071c4b2f" start="20260804005900 +0000" stop="20260804012900 +0000">
    <title>Kenan y Kel</title>
    <episode-num system="onscreen">S02E01</episode-num>
    <episode-num system="pluto">5eff43131bfe8e001a9a55c7</episode-num>
    <episode-num system="original-air-date">19970101000000 +0000</episode-num>
    <desc>Kenan entra en pánico cuando la directora de la escuela pide una reunión con él y sus padres. Pensando que hizo algo malo, decide contratar a dos actores para que hagan de sus padres durante la cita.</desc>
    <icon src="https://images.pluto.tv/series/5eff42e91bfe8e001a9a5460/tile_1768770360980.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
