    <sub-title>Cuentos de primavera</sub-title>
    <category>Series</category>
    <category>Documentary</category>
  </programme>
  <programme channel="5dd85eac039bba0009e86d1d" start="20260804064500 +0000" stop="20260804074500 +0000">
    <title>Historias del Bosque Mediterráneo</title>
    <episode-num system="onscreen">S01E03</episode-num>
    <episode-num system="pluto">67d82f1d159605af549662e3</episode-num>
    <episode-num system="original-air-date">20170101000000 +0000</episode-num>
    <desc>En esta tierra donde las temperaturas en verano suelen superar los 30º Celsius (86º Fahrenheit), la vida durante los meses más calurosos del año se vuelve especialmente complicada.</desc>
    <icon src="https://images.pluto.tv/series/67d82db046d66c4aa0c2f0ff/tile_1776895817047.jpg?fill=blur&amp;fit=fill&amp;fm=jpg&amp;h=900&amp;q=75&amp;w=900"/>
    <date>20170101</date>
